         g2 r4 d8 d8 |
         b'8. b16 g4 a4 a,4 |
         d8[ e8 f8 g8] a4 d,4 |
         a2. d4 |

%10
         e1 |
         a,4 a'8. a16 a8 a8 b8 a8 |
         gis8. gis16 a8 g8 f4 e4 |
         d2 g2 |
         f4. f8 d'4 c8 b8 |

%15
